{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortWatch",
  "version": "0.1.0",
  "identifier": "dev.portwatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "compact",
        "title": "PortWatch Panel",
        "url": "index.html?view=compact",
        "width": 400,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      },
      {
        "label": "full",
        "title": "PortWatch",
        "url": "index.html?view=full",
        "width": 980,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Find occupied ports",
    "longDescription": "PortWatch is a tray-first utility that shows listening TCP and UDP ports and the processes that own them.",
    "copyright": "Copyright PortWatch contributors"
  }
}
